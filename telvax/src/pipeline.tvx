# src/pipeline.py: load, clean, both annotators, their agreement, the daily timeline, the classifier and its benchmark,
# the LDA topics (and the choice of their number), the figures and reports/metrics.json.
from tweets import Tweet
from preprocessing import clean_tweet, preprocess_text
from textblob import polarity
from vader import compound
from sentiment import Agreement, label_agreement, label_from_polarity, label_from_vader_compound
from models import Evaluation, ModelScore, TopicTuning, train_and_evaluate, benchmark_models, topics, tune_num_topics
from wordcloud import svg

# The options of src/main.py.
type Config:
    input: Text
    output: Text
    text_column: Text
    sample: Int
    num_topics: Int
    num_words: Int
    tune_topics: Bool
    seed: Int
    max_features: Int
    test_size: Float

# A tweet after cleaning and scoring.
type Scored:
    tweet_text: Text
    clean_text: Text
    sentiment: Float
    sentiment_label: Text
    vader_compound: Float
    vader_label: Text
    day: Text

type Timeline:
    start: Text
    end: Text
    days: Int
    most_negative_day: Text
    most_positive_day: Text

type Topic:
    topic: Int
    top_words: List[Text]

# reports/metrics.json, with the keys of the Python program in its order.
type Metrics:
    tweets_analyzed: Int
    num_topics: Int
    sample_size: Int?
    random_state: Int
    accuracy: Float
    confusion_matrix: List[List[Int]]
    labels: List[Text]
    classification_report: Text
    label_agreement: Agreement
    sentiment_timeline: Timeline?
    topic_coherence: TopicTuning?
    model_benchmark: List[ModelScore]
    topics: List[Topic]

# load_data, preprocess_dataframe, the filter of empty texts and add_sentiment_columns. A sample is drawn with
# std.table.sample and the seed: the same seed gives the same tweets on every run, but not the tweets pandas picks.
fn load(config: Config) -> Result[List[Scored], Text]:
    if config.text_column != "text":
        return Err(f"the column `{config.text_column}` is not in the table; the text of a tweet is `text`")
    let all: Table[Tweet] = std.table.read_csv(config.input)
    var t = all
    if config.sample > 0 and config.sample < std.math.to_int(all.len()):
        t = std.table.sample(all, config.sample, config.seed)
    let out: List[Scored] = []
    var i = 0
    let dates = t.date
    for text in t.text:
        let tweet_text = clean_tweet(text)
        let clean_text = preprocess_text(tweet_text)
        if not clean_text.trim().is_empty():
            let p = polarity(tweet_text)
            let c = compound(tweet_text)
            let day = f"{dates.get(i).unwrap()}".slice(0, 10)
            out.push(Scored(tweet_text: tweet_text, clean_text: clean_text, sentiment: p, sentiment_label: label_from_polarity(p), vader_compound: c, vader_label: label_from_vader_compound(c), day: day))
        i = i + 1
    Ok(out)

# build_timeline: the mean of both scores per day, the days in order.
fn daily(rows: List[Scored]) -> (List[Text], List[Float], List[Float]):
    let n: Map[Text, Int] = std.map.new()
    let tb: Map[Text, Float] = std.map.new()
    let vd: Map[Text, Float] = std.map.new()
    for r in rows:
        n.insert(r.day, n.get(r.day).unwrap_or(0) + 1)
        tb.insert(r.day, tb.get(r.day).unwrap_or(0.0) + r.sentiment)
        vd.insert(r.day, vd.get(r.day).unwrap_or(0.0) + r.vader_compound)
    let days = n.keys()
    let textblob = days |> std.iter.map(d => tb.get(d).unwrap() / std.math.to_float(n.get(d).unwrap()))
    let vader = days |> std.iter.map(d => vd.get(d).unwrap() / std.math.to_float(n.get(d).unwrap()))
    (days, textblob, vader)

# timeline_summary: the first and last day, how many, the day TextBlob finds most negative and VADER most positive.
fn summary(days: List[Text], textblob: List[Float], vader: List[Float]) -> Timeline?:
    if days.is_empty():
        return None
    var lo = 0
    var hi = 0
    for i in range(std.math.to_int(days.len())):
        if textblob.get(i).unwrap() < textblob.get(lo).unwrap():
            lo = i
        if vader.get(i).unwrap() > vader.get(hi).unwrap():
            hi = i
    Some(Timeline(start: days.first().unwrap(), end: days.last().unwrap(), days: std.math.to_int(days.len()), most_negative_day: days.get(lo).unwrap(), most_positive_day: days.get(hi).unwrap()))

fn figures(output: Text, rows: List[Scored], days: List[Text], textblob: List[Float], vader: List[Float]) -> Result[Int, Text]:
    let dir = output + "/figures"
    std.fs.create_dir(dir)?
    let dist = std.plot.density(rows |> std.iter.map(r => r.sentiment), 30, "Sentiment Distribution in Tweets")
    std.fs.write(dir + "/sentiment_distribution.svg", std.plot.axis_titles(dist, "Sentiment Polarity", "Frequency"))?
    if not days.is_empty():
        let series: Map[Text, List[Float]] = std.map.new()
        series.insert("TextBlob", textblob)
        series.insert("VADER", vader)
        let xs = days |> std.iter.map(d => std.time.parse(d, "%Y-%m-%d").unwrap_or(0.0) / 86400.0)
        let line = std.plot.lines(xs, series, "Daily Average Sentiment Over Time")
        std.fs.write(dir + "/sentiment_timeline.svg", std.plot.axis_titles(line, "Date (days since 1970)", "Average Polarity"))?
    Ok(2)

fn run(config: Config) -> Result[Metrics, Text]:
    let rows = load(config)?
    let agreement = label_agreement(rows |> std.iter.map(r => r.sentiment_label), rows |> std.iter.map(r => r.vader_label))?
    let (days, textblob, vader) = daily(rows)
    figures(config.output, rows, days, textblob, vader)?
    let clean = rows |> std.iter.map(r => r.clean_text)
    let labels = rows |> std.iter.map(r => r.sentiment_label)
    var tuning: TopicTuning? = None
    if config.tune_topics:
        tuning = Some(tune_num_topics(clean, config.max_features, config.num_words, config.seed))
    let found = topics(clean, config.num_topics, config.max_features, config.num_words, config.seed)
    let evaluation = train_and_evaluate(clean, labels, config.max_features, config.test_size, config.seed)
    let benchmark = benchmark_models(clean, labels, config.max_features, config.test_size, config.seed)
    wordclouds(config.output, found)?
    var numbered: List[Topic] = []
    var k = 1
    for words in found:
        numbered.push(Topic(topic: k, top_words: words))
        k = k + 1
    let sample_size = None if config.sample <= 0 else Some(config.sample)
    Ok(Metrics(tweets_analyzed: std.math.to_int(rows.len()), num_topics: config.num_topics, sample_size: sample_size, random_state: config.seed, accuracy: evaluation.accuracy, confusion_matrix: evaluation.confusion_matrix, labels: evaluation.labels, classification_report: evaluation.classification_report, label_agreement: agreement, sentiment_timeline: summary(days, textblob, vader), topic_coherence: tuning, model_benchmark: benchmark, topics: numbered))

# plot_wordclouds: figures/wordclouds/topic_<n>.svg, the words weighted by their rank in the topic.
fn wordclouds(output: Text, found: List[List[Text]]) -> Result[Int, Text]:
    let dir = output + "/figures/wordclouds"
    std.fs.create_dir(dir)?
    var k = 1
    for words in found:
        let n = std.math.to_float(words.len())
        var weights: List[Float] = []
        var i = 0.0
        for w in words:
            weights.push(n - i)
            i = i + 1.0
        std.fs.write(f"{dir}/topic_{k}.svg", svg(f"Topic #{k}", words, weights))?
        k = k + 1
    Ok(k - 1)

fn write_metrics(output: Text, m: Metrics) -> Result[Text, Text]:
    std.fs.create_dir(output)?
    let path = output + "/metrics.json"
    std.fs.write(path, std.json.stringify(m, 2))?
    Ok(path)
