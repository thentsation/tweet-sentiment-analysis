from pipeline import Config, run, write_metrics

let CSV = "user_name,user_location,user_description,user_created,user_followers,user_friends,user_favourites,user_verified,date,text,hashtags,source,is_retweet\na,,,2020-01-01 00:00:00,1,2,3,False,2020-07-25 10:00:00,What a great day for science,,web,False\nb,,,2020-01-01 00:00:00,1,2,3,False,2020-07-25 11:00:00,This is terrible and sad,,web,False\nc,,,2020-01-01 00:00:00,1,2,3,False,2020-07-26 09:00:00,the of and,,web,False\nd,,,2020-01-01 00:00:00,1,2,3,False,2020-07-26 12:00:00,Masks work. Stay home,,web,False\n"

fn test_the_report_has_the_keys_and_values_of_the_python_pipeline():
    std.fs.create_dir("test-output").unwrap()
    std.fs.write("test-output/tweets.csv", CSV).unwrap()
    let config = Config(input: "test-output/tweets.csv", output: "test-output/reports", text_column: "text", sample: 0, num_topics: 5, num_words: 10, tune_topics: False, seed: 42, max_features: 3000, test_size: 0.2)
    let m = run(config).unwrap()
    # "the of and" is only stop words, so it is left out.
    assert_eq(m.tweets_analyzed, 3)
    let tl = m.sentiment_timeline.unwrap()
    assert_eq((tl.start, tl.end, tl.days), ("2020-07-25", "2020-07-26", 2))
    assert_eq(m.sample_size, None)
    let path = write_metrics("test-output/reports", m).unwrap()
    let text = std.fs.read(path).unwrap()
    for key in ["tweets_analyzed", "num_topics", "sample_size", "random_state", "accuracy", "confusion_matrix", "labels", "classification_report", "label_agreement", "sentiment_timeline", "topic_coherence", "model_benchmark", "topics"]:
        assert(text.contains(f"\"{key}\""))
    assert(std.fs.exists("test-output/reports/figures/sentiment_distribution.svg"))
    assert(std.fs.exists("test-output/reports/figures/sentiment_timeline.svg"))
